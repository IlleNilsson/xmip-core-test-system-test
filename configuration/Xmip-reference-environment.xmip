# The Reference Environment, Xmip's one definition of an environment
# (ADR-0028, amendment 2026-11-26), drawn in the Reference Environment deck
# (asset/brand/presentation/Xmip-reference-environment.pptx).
#
# The cluster configuration the System Tests and the Systems Tests use: one
# file for a run as local processes on one computer and for the same cluster
# on virtual machines of its own (the owner, 2026-10-21: *one TOML file that
# can be run for tests regardless of node faking or actual nodes*;
# 2026-11-25: *I still don't get why there is a need for two files?*;
# ADR-0028, amendment 2026-11-25). It
# says what the cluster is — its nodes and their roles, where each reaches
# Xmip Storage and is operated from, its Parties and its Xmip Applications —
# and, in [environment] at its end, the far ends it trades with and the
# virtual machines it runs on, which slicing gives no node. It names no
# address of a machine, no absolute path and no cluster name. As local
# processes the run gives those: Start-XmipTest's -Cluster names the
# cluster, and the run gives each node it starts its addresses on loopback,
# its certificate from the run's authority and the bindings, whose
# addresses are the run's own directories, and, loopback losing no SYN, no
# connect's SYN sent again (`[tuning] connect_retransmissions = 0`;
# src/served.rs). On virtual machines Deploy-XmipEnvironment gives them
# from this file (deploy/dsc): its -Cluster names the cluster, and each
# machine is given its node's slice of this file.
#
# A node finds the others by name: `DS1:7443` is the node DS1, resolved as
# every name is, never "this machine". A path is relative to the node's
# configuration file, so `tls/node.pem` is where the environment put this
# node's certificate, whatever machine it is on.

# The short name every operator surface shows for the cluster, its tooltip
# carrying this file's name, the cluster's name the run gives it and this
# file (the owner, 2026-11-28: *Lets keep the file name as
# Xmip-reference-environment, add a short name to be shown, use CRE for the
# short name*; *The short name should be declared in the xmip file*;
# ADR-0028, amendment 2026-11-28). It is no cluster name: the run's -Cluster
# still names the cluster. Every node's slice carries it, signed.
[service]
short_name = "CRE"

# Operated over gRPC at the node's address, on the operate plane's port,
# inside Xmip's mutual TLS (ADR-0014, ADR-0063); its local endpoint,
# xmip-<node>, always starts. The certificate is the node's, from the
# cluster's own authority; the anchors are that authority, which an
# operator's certificate must reach. Reaching them grants nothing: each
# caller holds the role its own name is listed with, and none where no list
# names it (ADR-0009, amendment 2026-11-07). On one computer the run lists
# the tester among every node's operators: the account it runs as, and the
# subject of every operator certificate the System Tests' authority signed
# (src/served/given.rs); on virtual machines Deploy-XmipEnvironment lists the
# subject of the operator certificate it made, and each its -Operator names.
[operate]
listen = "0.0.0.0:7401"
certificate = "tls/node.pem"
key = "tls/node.key"
anchors = "tls/anchors.pem"

# Xmip Storage, reached by name over Xmip's mutual TLS with the node's own
# certificate (ADR-0063; ADR-0067, amendment 2026-10-13). Only DS1 and DS2
# keep it, each serving it on the Storage plane's port; every other node
# reaches them (ADR-0056, amendment 2026-10-20). They are the primary and
# its standby, as they settle it, the first listed the first primary
# (ADR-0056, amendment 2026-10-22).
[storage]
nodes = ["DS1:7443", "DS2:7443"]
listen = "0.0.0.0:7443"
certificate = "tls/node.pem"
key = "tls/node.key"
anchors = "tls/anchors.pem"

# The nodes, named as the owner names them (ADR-0056, amendment 2026-11-12),
# as his node plan of 2026-11-22 lays them out: RX1 to RX3 receive, TX1 to
# TX3 send, EX1 works between them, Order approval's module installed there,
# EX2 receives, processes and sends in one node at low latency, OP1 operates
# and monitors, DS1 and DS2 keep Xmip Storage. One node covering every role
# works too; receiving, executing and sending nodes are split as security,
# firewall and load need (ADR-0056, amendment 2026-11-22). What each does is
# its roles, never its letters. Beside its roles, which are Xmip's, a node
# declares its Node capabilities, `capabilities`: what its environment gives
# it, a firewall opening, software installed, a system it reaches, in words
# Xmip only matches against what work requires (ADR-0056, amendment
# 2026-11-24). RX1 and TX3 have the internet, `online`: on virtual machines
# they alone are given the way out, through the gateway below (the owner,
# 2026-11-25: "Internal TX3 shall have access to the Internet as RX1").

[nodes.RX1]
roles = "receiving"
capabilities = ["online"]

[nodes.RX2]
roles = "receiving"

[nodes.RX3]
roles = "receiving"

# Order approval's module is installed here.
[nodes.EX1]
roles = "processing"
capabilities = ["order-approval-module"]

# Party-D's and Party-E's firewall openings reach this node, and it reaches
# the ERP directly.
[nodes.EX2]
roles = "executing"
capabilities = ["firewall-party-d", "firewall-party-e", "erp-direct"]

[nodes.TX1]
roles = "sending"

[nodes.TX2]
roles = "sending"

[nodes.TX3]
roles = "sending"
capabilities = ["online"]

[nodes.OP1]
roles = "operational, monitoring"

# A person's request is signed by the cluster's authority this table names,
# the `authority` folder beside the node's slice, where the trust reads its
# anchor and, where the authority's key is kept, its key (ADR-0034,
# amendment 2026-10-15). It is part of the node's signed slice, so a hand
# edit of it is refused (ADR-0031, amendment 2026-11-19). The System Tests
# sign a tester's request by this slice (Initialize-XmipSystemTestAuthority).
[nodes.OP1.provision.operator]
authority = "authority"

[nodes.DS1]
roles = "storage"

[nodes.DS2]
roles = "storage"

# The Parties the cluster trades with (ADR-0019; ADR-0028, amendment
# 2026-10-13). Each sends into the System Tests over its share of the
# transports and is delivered to over another share, presenting the
# identity written here; the 50-second fault moves across them. Rename them
# here: nothing in the System Tests' code names a Party. Each Party is
# written with its id, a UUIDv7 minted once with it, and each identity
# with the mechanism that verifies it and what it is for (the owner,
# 2026-10-19).

[[parties]]
id = "01a1577b-4402-7ccf-8dbc-c2e0d7ec5189"
name = "Party-A"
identities = [
  { mechanism = "mutual-tls", purpose = "receive", value = "CN=party-a.example" },
]

[[parties]]
id = "01a1577b-4418-7c64-8ea4-cd84a22a31f4"
name = "Party-B"
identities = [
  { mechanism = "mutual-tls", purpose = "receive", value = "CN=party-b.example" },
]

[[parties]]
id = "01a1577b-441a-7aba-9cfa-9328e46f7004"
name = "Party-C"
identities = [
  { mechanism = "mutual-tls", purpose = "receive", value = "CN=party-c.example" },
]

[[parties]]
id = "01a1577b-441b-7160-af1d-8d6bc087d827"
name = "Party-D"
identities = [
  { mechanism = "mutual-tls", purpose = "receive", value = "CN=party-d.example" },
]

[[parties]]
id = "01a1577b-441c-7945-a51b-11efd67a0878"
name = "Party-E"
identities = [
  { mechanism = "mutual-tls", purpose = "receive", value = "CN=party-e.example" },
]

# The Work Process unit "Order approval" is: `order-approval.bpmn` beside
# this file, compiled by `process::generate` into the example
# `order_approval`, which the run builds and copies beside each node the
# placement runs it on. The entry is the generator's, as written: its
# library named by the module, and each node names the file as its own
# system does (`xmip_module.h` section 1), so this one file serves Windows
# and Linux nodes alike.
[[modules]]
name = "order-approval"
start = true

[modules.manifest]
offline = true

[modules.manifest.identity]
name = "order-approval"
version = "0.1.0"

[[modules.manifest.capabilities]]
capability = "work-process"
execution_host = "native-rust"
trusted_required = false

[modules.manifest.entrypoint]
library_path = "order_approval"
symbol = "xmip_create_module_v1"

[[modules.manifest.units]]
name = "OrderApproval"
capability = "work-process"
stages = ["process"]
offline = true

# Two Xmip Applications (ADR-0064), each a business flow an ERP runs with
# its Parties: order to cash and procure to pay. The Parties trade real
# documents, UN/EDIFACT interchanges (`documents/`), and the company's ERP —
# played by the rig — sends its own to them through the ERP's Receive
# Locations and is delivered theirs through the "… to ERP" Send Ports. A
# Stream arrives at a node that declared receive, is published, and each
# Subscription picks up one kind of document and routes it to its Send Port
# by two properties promoted from the document itself, as a trading Party's
# documents are routed: the message type, `content:edi:UNH/2/1` (UNH S009
# 0065), and the recipient, `content:edi:UNB/3/1` (UNB S003 0010), which
# the `content` route technology reads through the `edi` path language
# (ADR-0046, amendment 2026-11-11). The names say what moves and with whom;
# what it moves over is each Location's transport, which the operation tools
# show from the configuration (the owner, 2026-10-13). An operator pauses
# and resumes these Subscriptions in the Subscriptions view (ADR-0013,
# amendment 2026-09-30); they are added and removed here, and nowhere else.
#
# Where each piece of work runs is placed (`configure::placed`), by what it
# requires and what each node declares, never by a node's name: each Receive
# Location goes to the next node serving Receive and each Send Port to the
# next serving Send, round robin in this file's order, a Work Process to
# every node serving its stage, and work naming Node capabilities in
# `requires` only to the nodes declaring each of them (ADR-0056, amendment
# 2026-11-24).
# So the remittance advices and the inventory reports, which come in through
# Party-E's and Party-D's firewall openings and go to the ERP directly, are
# received and sent on in one node, the executing one; the sales orders pass
# Order approval where its module is installed, on the processing node
# alone; every other document goes round the nodes serving its stage; and
# every node of the plan takes work (ADR-0028, amendment 2026-11-24). The
# Subscriptions filter on what a document holds, never on a node.

[[xmip_applications]]
name = "Order to cash"

[[xmip_applications.receive_ports]]
name = "Sales orders"

[[xmip_applications.receive_ports]]
name = "Remittance advices"

[[xmip_applications.receive_ports]]
name = "Order to cash documents from ERP"

[[xmip_applications.receive_locations]]
name = "Remittance advices from Party-E"
receive_port = "Remittance advices"
depth = "light"
requires = ["firewall-party-e"]

[[xmip_applications.receive_locations]]
name = "Sales orders from Party-A"
receive_port = "Sales orders"
depth = "light"

[[xmip_applications.receive_locations]]
name = "Sales orders from Party-C"
receive_port = "Sales orders"
depth = "light"

# The ERP's order responses, dispatch advices and invoices, to the Parties.
[[xmip_applications.receive_locations]]
name = "Order to cash documents from ERP"
receive_port = "Order to cash documents from ERP"
depth = "light"

[[xmip_applications.send_ports]]
name = "Remittance advices to ERP"
requires = ["erp-direct"]

[[xmip_applications.send_ports]]
name = "Sales orders to ERP"

[[xmip_applications.send_ports]]
name = "Order responses to Party-A"

[[xmip_applications.send_ports]]
name = "Dispatch advices to Party-A"

# A second Location for failover: the next is tried when the first has
# failed its retries.
[[xmip_applications.send_ports]]
name = "Invoices to Party-A"
send_locations = ["Invoices to Party-A", "Invoices to Party-A, failover"]
failover = "next"

# Every sales order is approved before the ERP takes it: the Subscription
# "Sales orders" hands each to the Work Process, which marks it
# `Approval = 'approved'`, a new Message generation, and publishes it back
# through routing, where "Approved sales orders" takes it to the ERP. An
# order already marked is never handed to the Work Process again.
[[xmip_applications.work_processes]]
name = "Order approval"
module = "order-approval"
unit = "OrderApproval"
requires = ["order-approval-module"]

[[xmip_applications.subscriptions]]
id = "Sales orders"
destination = { work-process = "Order approval" }
filter = "\"content:edi:UNH/2/1\" = 'ORDERS' and \"content:edi:UNB/3/1\" = 'SYSTEM-TEST' and not exists Approval"

[[xmip_applications.subscriptions]]
id = "Approved sales orders"
destination = { send-port = "Sales orders to ERP" }
filter = "\"content:edi:UNH/2/1\" = 'ORDERS' and \"content:edi:UNB/3/1\" = 'SYSTEM-TEST' and Approval = 'approved'"

[[xmip_applications.subscriptions]]
id = "Remittance advices"
destination = { send-port = "Remittance advices to ERP" }
filter = "\"content:edi:UNH/2/1\" = 'REMADV' and \"content:edi:UNB/3/1\" = 'SYSTEM-TEST'"

[[xmip_applications.subscriptions]]
id = "Order responses"
destination = { send-port = "Order responses to Party-A" }
filter = "\"content:edi:UNH/2/1\" = 'ORDRSP' and \"content:edi:UNB/3/1\" = 'PARTY-A'"

[[xmip_applications.subscriptions]]
id = "Dispatch advices"
destination = { send-port = "Dispatch advices to Party-A" }
filter = "\"content:edi:UNH/2/1\" = 'DESADV' and \"content:edi:UNB/3/1\" = 'PARTY-A'"

[[xmip_applications.subscriptions]]
id = "Invoices"
destination = { send-port = "Invoices to Party-A" }
filter = "\"content:edi:UNH/2/1\" = 'INVOIC' and \"content:edi:UNB/3/1\" = 'PARTY-A'"

[[xmip_applications]]
name = "Procure to pay"

[[xmip_applications.receive_ports]]
name = "Purchase order responses"

[[xmip_applications.receive_ports]]
name = "Goods receipts"

[[xmip_applications.receive_ports]]
name = "Inventory"

[[xmip_applications.receive_ports]]
name = "Procure to pay documents from ERP"

[[xmip_applications.receive_locations]]
name = "Inventory reports from Party-D"
receive_port = "Inventory"
depth = "light"
requires = ["firewall-party-d"]

[[xmip_applications.receive_locations]]
name = "Purchase order responses from Party-B"
receive_port = "Purchase order responses"
depth = "light"

[[xmip_applications.receive_locations]]
name = "Goods receipts from Party-C"
receive_port = "Goods receipts"
depth = "light"

# The ERP's purchase orders, item master and payments, to the Parties.
[[xmip_applications.receive_locations]]
name = "Procure to pay documents from ERP"
receive_port = "Procure to pay documents from ERP"
depth = "light"

[[xmip_applications.send_ports]]
name = "Purchase order responses to ERP"

[[xmip_applications.send_ports]]
name = "Goods receipts to ERP"

[[xmip_applications.send_ports]]
name = "Purchase orders to Party-B"

[[xmip_applications.send_ports]]
name = "Inventory reports to ERP"
requires = ["erp-direct"]

[[xmip_applications.send_ports]]
name = "Item master to Party-D"

[[xmip_applications.send_ports]]
name = "Payments to Party-E"

[[xmip_applications.subscriptions]]
id = "Purchase order responses"
destination = { send-port = "Purchase order responses to ERP" }
filter = "\"content:edi:UNH/2/1\" = 'ORDRSP' and \"content:edi:UNB/3/1\" = 'SYSTEM-TEST'"

[[xmip_applications.subscriptions]]
id = "Goods receipts"
destination = { send-port = "Goods receipts to ERP" }
filter = "\"content:edi:UNH/2/1\" = 'RECADV' and \"content:edi:UNB/3/1\" = 'SYSTEM-TEST'"

[[xmip_applications.subscriptions]]
id = "Inventory reports"
destination = { send-port = "Inventory reports to ERP" }
filter = "\"content:edi:UNH/2/1\" = 'INVRPT' and \"content:edi:UNB/3/1\" = 'SYSTEM-TEST'"

[[xmip_applications.subscriptions]]
id = "Purchase orders"
destination = { send-port = "Purchase orders to Party-B" }
filter = "\"content:edi:UNH/2/1\" = 'ORDERS' and \"content:edi:UNB/3/1\" = 'PARTY-B'"

# The item master travels as a price catalogue, PRICAT.
[[xmip_applications.subscriptions]]
id = "Item master"
destination = { send-port = "Item master to Party-D" }
filter = "\"content:edi:UNH/2/1\" = 'PRICAT' and \"content:edi:UNB/3/1\" = 'PARTY-D'"

# Payments go to the bank as multiple payment orders, PAYMUL.
[[xmip_applications.subscriptions]]
id = "Payments"
destination = { send-port = "Payments to Party-E" }
filter = "\"content:edi:UNH/2/1\" = 'PAYMUL' and \"content:edi:UNB/3/1\" = 'PARTY-E'"

# Where the cluster runs, the environment's: never given to a node by slicing
# (ADR-0031, amendment 2026-11-25), and of it a run as local processes reads
# the far ends alone. Deploy-XmipEnvironment -Path <this file> -Cluster
# <name> makes one virtual machine for each node, each far end and each
# machine of its own below, XMIP-<name>, on the network Xmip-<cluster>; and
# Start-XmipTest -VirtualMachine runs on what it made (ADR-0015 and
# ADR-0028, amendments 2026-11-25). No network is named here: Xmip picks a
# free private /24 on the host and keeps it, the host on the first address,
# then the machines of their own, the far ends and the nodes, in this
# file's order. The domain controller answers the names and is the way out
# for the nodes that declare `online`, NAT out of a second adapter on the
# host's uplink (ADR-0015, amendment 2026-11-24: "A good choice would be the
# DC"). Windows Server is Server Core (the owner, 2026-11-21).
[environment]
domain = "xmip.test"
domain_controller = "DC01"
gateway = "DC01"

# Every machine's own where it says none: what it starts and installs with,
# and the least and the most Hyper-V gives it as it uses it.
[environment.machine]
os = "AlmaLinux10"
cpu = 2
memory_gb = 2
dynamic_memory = { minimum_gb = 0.5, maximum_gb = 3 }
disk_gb = 32

# The far ends outside the cluster, as the owner's node plan of 2026-11-22
# lays them out: three that send to it and three it sends to (ADR-0028,
# amendment 2026-11-22). They are the System Tests', never Xmip's: as local
# processes each is the process xmip-system-test-<cluster>-external-<name>,
# on a virtual machine the service xmip-<name>. A sender drops into Receive
# Locations, each round the next sender in turn into each, so every sender
# reaches every node that receives; a receiver takes what Send Ports
# deliver, each Send Port delivering to one, round robin in the order they
# are placed in. Rename them here: nothing in the System Tests' code names
# one.
[environment.far_ends]
senders = ["EXTTX1", "EXTTX2", "EXTTX3"]
receivers = ["EXTRX1", "EXTRX2", "EXTRX3"]

# What a run in containers runs every node and far end in, one container
# each, Start-XmipTest -Container (ADR-0015 and ADR-0028, amendments
# 2026-11-25): a Linux image, AlmaLinux's own as the plan's Linux machines
# run AlmaLinux, which the container tool pulls where it has none. The
# containers are Linux wherever they live, WSL containers on Windows and
# Podman on Linux, so a machine's `os` below is its virtual machine's alone.
[environment.container]
image = "quay.io/almalinuxorg/10-minimal:latest"

# The machines of the plan that run no node and no far end: the domain
# controller, the file storage and the people's machines. Every other name
# here is a node's or a far end's machine, where it differs from the
# default; the plan runs half of each on Windows Server. A machine of its
# own says what it is for, `purpose`, in its description, where it is not
# the domain controller or the gateway, which say so themselves.
[environment.machines.DC01]
os = "WindowsServer2025"
dynamic_memory = { minimum_gb = 1, maximum_gb = 4 }
disk_gb = 64

# Optional: brings software and packages into the premises.
[environment.machines.FS01]
purpose = "file storage"
os = "WindowsServer2025"
memory_gb = 1
dynamic_memory = { minimum_gb = 0.5, maximum_gb = 2 }
disk_gb = 64

[environment.machines.DEV01]
purpose = "developer machine"
os = "Windows11"
memory_gb = 4
dynamic_memory = { minimum_gb = 2, maximum_gb = 4 }
disk_gb = 128

[environment.machines.DEV02]
purpose = "developer machine"
os = "AlmaLinux10Desktop"
dynamic_memory = { minimum_gb = 1, maximum_gb = 4 }
disk_gb = 64

# The operator's machine runs OP1 (the coordinator, 2026-11-25).
[environment.machines.OP1]
os = "Windows11"
memory_gb = 4
dynamic_memory = { minimum_gb = 2, maximum_gb = 4 }
disk_gb = 128

[environment.machines.DS1]
dynamic_memory = { minimum_gb = 0.5, maximum_gb = 4 }

[environment.machines.DS2]
os = "WindowsServer2025"
memory_gb = 1
dynamic_memory = { minimum_gb = 0.5, maximum_gb = 4 }
disk_gb = 64

[environment.machines.RX2]
os = "WindowsServer2025"
memory_gb = 1
disk_gb = 64

[environment.machines.EX1]
os = "WindowsServer2025"
memory_gb = 1
dynamic_memory = { minimum_gb = 0.5, maximum_gb = 4 }
disk_gb = 64

[environment.machines.EX2]
dynamic_memory = { minimum_gb = 0.5, maximum_gb = 4 }

[environment.machines.TX1]
os = "WindowsServer2025"
memory_gb = 1
disk_gb = 64

[environment.machines.TX3]
os = "WindowsServer2025"
memory_gb = 1
disk_gb = 64

[environment.machines.EXTTX1]
cpu = 1
dynamic_memory = { minimum_gb = 0.5, maximum_gb = 2 }

[environment.machines.EXTTX2]
os = "WindowsServer2025"
cpu = 1
memory_gb = 1
dynamic_memory = { minimum_gb = 0.5, maximum_gb = 2 }
disk_gb = 64

[environment.machines.EXTTX3]
cpu = 1
dynamic_memory = { minimum_gb = 0.5, maximum_gb = 2 }

[environment.machines.EXTRX1]
os = "WindowsServer2025"
cpu = 1
memory_gb = 1
dynamic_memory = { minimum_gb = 0.5, maximum_gb = 2 }
disk_gb = 64

[environment.machines.EXTRX2]
cpu = 1
dynamic_memory = { minimum_gb = 0.5, maximum_gb = 2 }

[environment.machines.EXTRX3]
os = "WindowsServer2025"
cpu = 1
memory_gb = 1
dynamic_memory = { minimum_gb = 0.5, maximum_gb = 2 }
disk_gb = 64

# The installation images, by operating system, each found on the host by
# its SHA-256 under Deploy-XmipEnvironment's -ImageFolder: the publishers'
# ISOs, never a path here. Server Core: a node needs no Desktop Experience
# (the owner, 2026-11-21). A TPM where an image asks for one, as Windows
# 11's Setup does. `name` is the system in words, which each machine's
# description says beside its role.
[environment.images.WindowsServer2025]
name = "Windows Server 2025 Server Core"
sha256 = "d0ef4502e350e3c6c53c15b1b3020d38a5ded011bf04998e950720ac8579b23d"
family = "Windows"
edition = "Windows Server 2025 SERVERDATACENTERCORE"
secureBootTemplate = "MicrosoftWindows"
tpm = false

[environment.images.Windows11]
name = "Windows 11 Enterprise"
sha256 ="bc3f24086ebadc94489066b5ad78089e2cf5c3491e90e790bb81a2b199c10e38"
family = "Windows"
edition = "Windows 11 Enterprise Evaluation"
secureBootTemplate = "MicrosoftWindows"
tpm = true

[environment.images.AlmaLinux10]
name = "AlmaLinux 10"
sha256 ="90244ac532f67c978831a381b420da8bda363729e1f4cf8fb8991daca70ee287"
family = "Linux"
secureBootTemplate = "MicrosoftUEFICertificateAuthority"
tpm = false

# The same DVD with a desktop, for the people's machines alone: the kickstart
# installs the environment group named here and starts the graphical target.
[environment.images.AlmaLinux10Desktop]
name = "AlmaLinux 10 with a desktop"
sha256 ="90244ac532f67c978831a381b420da8bda363729e1f4cf8fb8991daca70ee287"
family = "Linux"
environment = "workstation-product-environment"
secureBootTemplate = "MicrosoftUEFICertificateAuthority"
tpm = false